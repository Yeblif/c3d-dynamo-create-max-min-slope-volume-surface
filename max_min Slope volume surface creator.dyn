    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "NodeType": "FunctionNode",
      "FunctionSignature": "Autodesk.Civil.DynamoNodes.CivilObject.Name",
      "Id": "2652c0d9a38d415f9cff2e0ece41ec68",
      "Inputs": [
        {
          "Id": "13b71ac494044482bee96b78a6cd78bc",
          "Name": "civilObject",
          "Description": "Autodesk.Civil.DynamoNodes.CivilObject",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4117654d2ed540b092b66c7c1bf6f627",
          "Name": "string",
          "Description": "string",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Get the name of the civil object.\n\nCivilObject.Name: string"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference(\"AcMgd\")\r\nclr.AddReference(\"AcDbMgd\")\r\nclr.AddReference(\"AeccDbMgd\")\r\nclr.AddReference(\"System\")\r\n\r\nfrom System import Array\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode, ObjectId\r\nfrom Autodesk.AutoCAD.Colors import Color\r\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\r\nfrom Autodesk.Civil.DatabaseServices import Surface, SurfaceAnalysisSlopeData\r\n\r\nadoc  = Application.DocumentManager.MdiActiveDocument\r\ndb    = adoc.Database\r\ncdoc  = CivilApplication.ActiveDocument\r\n\r\nsurf_in = IN[0]\r\ntable   = IN[1]\r\n\r\ndef get_objectid(x):\r\n    if isinstance(x, ObjectId):\r\n        return x\r\n    if hasattr(x, \"InternalObjectId\"):\r\n        return x.InternalObjectId\r\n    return None\r\n\r\ndef find_surface_id_by_name(name, tr):\r\n    for sid in cdoc.GetSurfaceIds():\r\n        s = tr.GetObject(sid, OpenMode.ForRead)\r\n        if hasattr(s, \"Name\") and s.Name == name:\r\n            return sid\r\n    return None\r\n\r\nlock = adoc.LockDocument()\r\ntry:\r\n    with db.TransactionManager.StartTransaction() as tr:\r\n\r\n        sid = get_objectid(surf_in)\r\n        if sid is None:\r\n            if isinstance(surf_in, str):\r\n                sid = find_surface_id_by_name(surf_in, tr)\r\n            if sid is None:\r\n                raise Exception(\"Surface not found (object or name).\")\r\n\r\n        # IMPORTANT: open FOR WRITE\r\n        surf = tr.GetObject(sid, OpenMode.ForWrite)\r\n        if not isinstance(surf, Surface):\r\n            raise Exception(\"Resolved object is not a Civil 3D Surface.\")\r\n\r\n        sasd = []\r\n        for row in table:\r\n            # row = [min%, max%, r,g,b]\r\n            mn = float(row[0]) / 100.0   # % -> 0-1 where 1.0 = 100%\r\n            mx = float(row[1]) / 100.0\r\n            col = Color.FromRgb(int(row[2]), int(row[3]), int(row[4]))\r\n            sasd.append(SurfaceAnalysisSlopeData(mn, mx, col))\r\n\r\n        # Typed .NET array (critical)\r\n        surf.Analysis.SetSlopeData(Array[SurfaceAnalysisSlopeData](sasd))\r\n\r\n        if hasattr(surf, \"Rebuild\"):\r\n            surf.Rebuild()\r\n\r\n        tr.Commit()\r\n\r\n        OUT = len(sasd)\r\n\r\nfinally:\r\n    lock.Dispose()\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "6e8fc2c7f4304f518e2c1a0ec25f624e",
      "Inputs": [
        {
          "Id": "410771cb44ad4f1794f7048e03b55bec",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
