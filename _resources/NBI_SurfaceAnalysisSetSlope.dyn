      "Code": "filename;\nnode_output;\n\nres = [Imperative]\n{\nif(node_output == \"Done\")\n{\nreturn = \"Analysis done\";\n}\nelseif(node_output == \"No valid Surface in block table\")\n{\nreturn = node_output;\n}\nelseif(node_output == \"No slope analysis defined in surface\")\n{\nreturn = node_output;\n}\nelse\n{\nfileout = DSOffice.Data.ExportCSV(filename, node_output);\nreturn = \"Analysis written in file\";\n}\n};",
