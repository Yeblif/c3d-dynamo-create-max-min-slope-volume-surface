        }
      ],
      "Replication": "Auto",
      "Description": "Get the name of the civil object.\n\nCivilObject.Name: string"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport math\r\n\r\n# Add Assemblies for AutoCAD and Civil3D\r\nclr.AddReference('AcMgd')\r\nclr.AddReference('AcCoreMgd')\r\nclr.AddReference('AcDbMgd')\r\nclr.AddReference('AecBaseMgd')\r\nclr.AddReference('AecPropDataMgd')\r\nclr.AddReference('AeccDbMgd')\r\nclr.AddReference('ProtoGeometry')\r\nclr.AddReference('AutoCADNodes')\r\nclr.AddReference('Civil3DNodes')\r\nclr.AddReference('Autodesk.Civil3DToolkit')\r\n\r\n\r\n# Import references from AutoCAD\r\nfrom Autodesk.AutoCAD.Runtime import *\r\nfrom Autodesk.AutoCAD.ApplicationServices import *\r\nfrom Autodesk.AutoCAD.EditorInput import *\r\nfrom Autodesk.AutoCAD.DatabaseServices import *\r\nfrom Autodesk.AutoCAD.Geometry import *\r\nfrom Autodesk.AutoCAD.Colors import *\r\nimport Autodesk.DesignScript.Geometry as DS\r\n\r\n# Import references from Civil3D\r\nfrom Autodesk.Civil.ApplicationServices import *\r\nfrom Autodesk.Civil.DatabaseServices import *\r\n\r\n# Import references from Civil3DToolkit package\r\nimport Autodesk.AutoCAD.DynamoNodes as DA # assign alias for AutoCAD nodes\r\nimport Autodesk.Civil.DynamoNodes as DC # assign alias for Civil 3D nodes\r\n\r\n\r\nfrom System import Array\r\n\r\n# Import references from Civil3D\r\nfrom Autodesk.Civil.ApplicationServices import *\r\nfrom Autodesk.Civil.DatabaseServices import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\nadoc = Application.DocumentManager.MdiActiveDocument\r\ncdoc = CivilApplication.ActiveDocument\r\neditor = adoc.Editor\r\n\r\ndef set_surface_analysis(surface_name, table, slopetype):\r\n\r\n\tglobal adoc\r\n\tglobal cdoc\r\n\r\n\twith adoc.LockDocument():\r\n\t\twith adoc.Database as db:\r\n\r\n\t\t\twith db.TransactionManager.StartTransaction() as t:\r\n            \t# Place your code below\r\n           \t\t# \r\n            \t#\r\n\t\t\t\tbt = t.GetObject(db.BlockTableId, OpenMode.ForWrite)\r\n\t\t\t\tbtr = t.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForWrite)\r\n\t\t\t\r\n\t\t\t\tsurface = None\r\n\t\t\t\tfor oid in cdoc.GetSurfaceIds():\r\n\t\t\t\t\tobj = t.GetObject(oid, OpenMode.ForRead)\r\n\t\t\t\t\tif obj.Name == surface_name:\r\n\t\t\t\t\t\tsurface = obj\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t\r\n\t\t\t\tif surface is None:\r\n\t\t\t\t\treturn \"No valid Surface in block table\"\r\n\t\t\t\t\r\n\t\t\t\tsasd = []\r\n\t\t\t\tsasad = []\r\n\t\t\t\r\n\t\t\t\tn = 0\r\n\t\t\t\tfor line in table:\r\n\t\t\t\t\tif len(line) >= 5:\r\n\t\t\t\t\t\tsasd.append(SurfaceAnalysisSlopeData(line[0],line[1],Color.FromRgb(line[2],line[3],line[4])))\r\n\t\t\t\t\t\tsasad.append(SurfaceAnalysisSlopeArrowData(line[0],line[1],Color.FromRgb(line[2],line[3],line[4])))\r\n\t\t\t\t\tn += 1\r\n\t\t\t\t\t\r\n\t\t\t\tif slopetype == \"Slopes\":\r\n\t\t\t\t\tsurface.Analysis.SetSlopeData(Array[SurfaceAnalysisSlopeData](sasd))\r\n\t\t\t\tif slopetype == \"SlopeArrows\":\r\n\t\t\t\t\tsurface.Analysis.SetSlopeArrowData(Array[SurfaceAnalysisSlopeArrowData](sasad))\r\n\t\t\t\r\n\t\t\t\r\n            \t# Commit before end transaction\r\n\t\t\t\tt.Commit()\r\n\treturn \"Done\"\r\n\r\ndef get_surface_analysis(surface_name, slopetype):\r\n\r\n\tglobal adoc\r\n\tglobal cdoc\r\n\r\n\twith adoc.LockDocument():\r\n\t\twith adoc.Database as db:\r\n\r\n\t\t\twith db.TransactionManager.StartTransaction() as t:\r\n            \t# Place your code below\r\n           \t\t# \r\n            \t#\r\n\t\t\t\tbt = t.GetObject(db.BlockTableId, OpenMode.ForWrite)\r\n\t\t\t\tbtr = t.GetObject(bt[BlockTableRecord.ModelSpace], OpenMode.ForWrite)\r\n\t\t\t\r\n\t\t\t\tsurface = None\r\n\t\t\t\tfor oid in cdoc.GetSurfaceIds():\r\n\t\t\t\t\tobj = t.GetObject(oid, OpenMode.ForRead)\r\n\t\t\t\t\tif obj.Name == surface_name:\r\n\t\t\t\t\t\tsurface = obj\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\t\r\n\t\t\t\tif surface is None:\r\n\t\t\t\t\treturn \"No valid Surface in block table\"\r\n\t\t\t\t\r\n\t\t\t\tsasd = []\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\tn = 0\r\n\t\t\t\tsasd.append([\"mins\",\"maxs\",\"r\",\"g\",\"b\"])\r\n\t\t\t\tif slopetype == \"Slopes\":\r\n\t\t\t\t\tfor item in surface.Analysis.GetSlopeData():\r\n\t\t\t\t\t\tsasd.append([item.MinimumSlope,item.MaximumSlope,item.Scheme.Red,item.Scheme.Green,item.Scheme.Blue])\r\n\t\t\t\t\t\tn += 1\r\n\t\t\t\telse:\r\n\t\t\t\t\tfor item in surface.Analysis.GetSlopeArrowData():\r\n\t\t\t\t\t\tsasd.append([item.MinimumSlope,item.MaximumSlope,item.Scheme.Red,item.Scheme.Green,item.Scheme.Blue])\r\n\t\t\t\t\t\tn += 1\r\n\t\t\t\tif len(sasd) == 1:\r\n\t\t\t\t\treturn \"No slope analysis defined in surface\"\t\t\t\t\r\n\t\t\t\r\n\t\t\t\r\n            \t# Commit before end transaction\r\n\t\t\t\tt.Commit()\r\n\treturn sasd\r\n# Assign your output to the OUT variable.\r\nslope_type = \"SlopeArrows\"\r\nif IN[3]:\r\n\tslope_type = \"Slopes\"\r\n\t\r\nif IN[2]:\r\n\tOUT = get_surface_analysis(IN[0], slope_type)\r\nelse:\r\n\tOUT = set_surface_analysis(IN[0], IN[1], slope_type)\r\n\t",
      "VariableInputPorts": true,
      "Id": "180be97ddfdc476c8fa427cd58ddc08e",
